# Public browser configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_TURNSTILE_SITE_KEY=
VITE_APP_URL=http://localhost:3000

# Server-only. Never prefix these variables with VITE_.
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Keep true until MNprogram is confirmed as the fiscal issuer. Then set false
# to avoid presenting a Stripe-generated document as a second invoice.
STRIPE_INVOICE_CREATION_ENABLED=true

# Automated billing and MNprogram (server-only)
MNPROGRAM_SYNC_ENABLED=false
MNPROGRAM_BASE_URL=
MNPROGRAM_INSTANCE=
MNPROGRAM_COMPANY_NUMBER=
MNPROGRAM_OPERATOR=
MNPROGRAM_TOKEN=
MNPROGRAM_PASS_MD5=
MNPROGRAM_WSDL_URL=
MNPROGRAM_CUSTOM_TAB=InmínerCampus
MNPROGRAM_EXPEDIENT_TITLE=INMINERCAMPUS
MNPROGRAM_EXPEDIENT_TYPE=Formación

# Vercel Cron and Windows/DataBox archive agent (server-only)
CRON_SECRET=
ARCHIVE_AGENT_TOKEN=
INMINERCAMPUS_ARCHIVE_API_URL=
INMINERCAMPUS_ARCHIVE_ROOT=
INMINERCAMPUS_ARCHIVE_POLL_MS=60000
INVOICE_EMAIL_FROM=InmínerCampus <campus@inminer.es>

# Administrative payment notifications (server-only).
RESEND_API_KEY=
ADMIN_NOTIFICATION_EMAIL=administracion@inminer.es
ADMIN_NOTIFICATION_FROM=InmínerCampus <campus@inminer.es>
ADMIN_APP_URL=http://localhost:3000

# Legacy optional Stripe Price IDs. The current checkout reads prices from
# the published Supabase course version and creates exact price_data snapshots.
STRIPE_PRICE_COURSE_5H=
STRIPE_PRICE_COURSE_20H=
